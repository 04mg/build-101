# The agent runs on the local Claude Code CLI (`claude -p`, Haiku 5.5): log in once with `claude`.
# Exa is Claude's web research tool (MCP), used by the Discover research.
EXA_API_KEY=
# The assistant bar (voice and text) runs on OpenAI GPT-Realtime over WebRTC.
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=marin
PORT=4000
HOST=0.0.0.0
TRAILBASE_PORT=4001
ENABLE_TUNNEL=1
# Founder network memory (Graphiti + FalkorDB, started by memory/run.sh). Optional.
MEMORY_PORT=4010
# Contact for Web Push (VAPID keys are generated and stored in SQLite).
VAPID_SUBJECT=mailto:cruce@example.com
# Optional OpenRouter embeddings for the network memory; without it, local embeddings are used.
# AI_API_KEY=
